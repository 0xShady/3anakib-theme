{
  "name": "3anakib",
  "displayName": "3anakib",
  "description": "3anakib theme, a theme for every language out there",
  "version": "1.0.1",
  "publisher": "achrafelfadili",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xShady/3anakib-theme.git"
  },
  "icon": "images/3ankob-logo.png",
  "keywords": [
    "theme",
    "dark theme",
    "3anakib",
    "spider",
    "shell theme",
    "python theme",
    "java script theme"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-themes.mjs",
    "vscode:prepublish": "npm run build"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:3anakib.toggleZen",
    "onCommand:3anakib.chooseCss",
    "onCommand:3anakib.removeCss"
  ],
  "contributes": {
    "themes": [
      {
        "label": "3anakib theme",
        "uiTheme": "vs-dark",
        "path": "./themes/3anakib theme-color-theme.json"
      },
      {
        "label": "3anakib darker",
        "uiTheme": "vs-dark",
        "path": "./themes/3anakib darker-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "3anakib.toggleZen",
        "title": "Toggle Zen Mode",
        "category": "3anakib"
      },
      {
        "command": "3anakib.chooseCss",
        "title": "Choose CSS Extras (Spotlight palette, Monospace UI…)",
        "category": "3anakib"
      },
      {
        "command": "3anakib.removeCss",
        "title": "Remove CSS Extras",
        "category": "3anakib"
      }
    ],
    "keybindings": [
      {
        "command": "3anakib.toggleZen",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z"
      }
    ]
  }
}
